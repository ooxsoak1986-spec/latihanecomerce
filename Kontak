<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Kontak Kami</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      background: linear-gradient(135deg, #0f0f0f, #1c1c1c);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .contact-container {
      background: rgba(255, 255, 255, 0.05);
      padding: 30px;
      border-radius: 15px;
      width: 350px;
      backdrop-filter: blur(10px);
      box-shadow: 0 0 20px rgba(255, 165, 0, 0.2);
    }

    .contact-container h2 {
      text-align: center;
      margin-bottom: 20px;
      color: orange;
    }

    .input-group {
      margin-bottom: 15px;
    }

    .input-group label {
      font-size: 14px;
    }

    .input-group input,
    .input-group textarea {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border: none;
      border-radius: 8px;
      outline: none;
      background: #222;
      color: white;
    }

    .input-group textarea {
      resize: none;
      height: 100px;
    }

    button {
      width: 100%;
      padding: 12px;
      background: orange;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.3s;
    }

    button:hover {
      background: #ff8800;
    }

    .success {
      text-align: center;
      margin-top: 10px;
      color: lightgreen;
      display: none;
    }
  </style>
</head>
<body>

  <div class="contact-container">
    <h2>Hubungi Kami</h2>
    <form id="contactForm">
      
      <div class="input-group">
        <label>Nama</label>
        <input type="text" required>
      </div>

      <div class="input-group">
        <label>Email</label>
        <input type="email" required>
      </div>

      <div class="input-group">
        <label>Pesan</label>
        <textarea required></textarea>
      </div>

      <button type="submit">Kirim</button>
      <div class="success" id="successMsg">Pesan berhasil dikirim!</div>

    </form>
  </div>

  <script>
    const form = document.getElementById("contactForm");
    const successMsg = document.getElementById("successMsg");

    form.addEventListener("submit", function(e) {
      e.preventDefault();
      successMsg.style.display = "block";
      form.reset();
    });
  </script>

</body>
</html>